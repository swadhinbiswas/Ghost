---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(/\/$/, '');

const nav = [
  {
    group: 'Getting Started',
    items: [
      { href: `${base}/docs`, label: 'Introduction' },
      { href: `${base}/docs/getting-started`, label: 'Installation' },
    ],
  },
  {
    group: 'Guides',
    items: [
      { href: `${base}/docs/commands`, label: 'Commands' },
      { href: `${base}/docs/providers`, label: 'Providers & Models' },
      { href: `${base}/docs/configuration`, label: 'Configuration' },
    ],
  },
];

const isActive = (href: string) => current === href.replace(/\/$/, '');
---

<BaseLayout title={`${title} · Ghost Docs`} description={description}>
  <div class="container docs-shell">
    <aside class="docs-side">
      <nav>
        {nav.map((g) => (
          <div class="nav-group">
            <p class="nav-group-title">{g.group}</p>
            <ul>
              {g.items.map((it) => (
                <li>
                  <a href={it.href} class={isActive(it.href) ? 'active' : ''}>{it.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>
    <article class="docs-body">
      <h1 class="docs-title gradient-text">{title}</h1>
      <slot />
    </article>
  </div>
</BaseLayout>

<style is:global>
  .docs-shell { display: grid; grid-template-columns: 240px 1fr; gap: 3rem; padding: 3rem 24px 5rem; align-items: start; }
  .docs-side { position: sticky; top: 88px; }
  .nav-group { margin-bottom: 1.6rem; }
  .nav-group-title {
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .14em;
    font-size: .7rem; color: var(--orange); margin-bottom: .6rem;
  }
  .docs-side ul { list-style: none; display: grid; gap: .15rem; }
  .docs-side a {
    display: block; padding: .4rem .7rem; border-radius: 8px;
    color: #c3c4da; font-weight: 600; font-size: .94rem;
    border-left: 2px solid transparent;
  }
  .docs-side a:hover { background: rgba(68,71,90,.4); color: var(--fg); }
  .docs-side a.active { color: var(--purple); background: rgba(189,147,249,.12); border-left-color: var(--purple); }

  .docs-body { max-width: 46rem; }
  .docs-title { font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 1.6rem; }
  .docs-body h2 { font-size: 1.5rem; margin: 2.4rem 0 .8rem; padding-top: .6rem; }
  .docs-body h3 { font-size: 1.15rem; margin: 1.6rem 0 .6rem; color: var(--cyan); }
  .docs-body p { color: #d2d3e6; margin: .8rem 0; }
  .docs-body ul, .docs-body ol { margin: .8rem 0 .8rem 1.3rem; color: #d2d3e6; display: grid; gap: .4rem; }
  .docs-body a { font-weight: 600; }
  .docs-body code {
    background: rgba(68,71,90,.55); padding: .12rem .42rem; border-radius: 6px;
    font-size: .88em; color: var(--green);
  }
  .docs-body pre.block {
    background: var(--bg-darker); border: 1px solid var(--current-line);
    border-radius: 10px; padding: 1.1rem 1.2rem; overflow-x: auto; margin: 1rem 0;
    font-family: var(--font-mono); font-size: .88rem; color: var(--fg); line-height: 1.6;
  }
  .docs-body pre.block code { background: none; color: inherit; padding: 0; }
  .docs-table { width: 100%; border-collapse: collapse; margin: 1.2rem 0; font-size: .92rem; }
  .docs-table th, .docs-table td { text-align: left; padding: .65rem .8rem; border-bottom: 1px solid var(--current-line); }
  .docs-table th { color: var(--orange); font-family: var(--font-mono); font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; }
  .docs-table td code { font-size: .85em; }
  .callout {
    border-left: 3px solid var(--purple); background: rgba(189,147,249,.1);
    padding: .9rem 1.1rem; border-radius: 0 10px 10px 0; margin: 1.4rem 0; color: #e3e3f5;
  }
  .callout.warn { border-left-color: var(--orange); background: rgba(255,184,108,.1); }

  @media (max-width: 820px) {
    .docs-shell { grid-template-columns: 1fr; }
    .docs-side { position: static; }
    .docs-side ul { grid-auto-flow: column; grid-auto-columns: max-content; overflow-x: auto; gap: .4rem; }
    .nav-group { margin-bottom: 1rem; }
  }
</style>
