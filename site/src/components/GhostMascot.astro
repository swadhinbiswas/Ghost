---
interface Props { size?: number; id?: string; }
const { size = 280, id = 'ghost-hero' } = Astro.props;
---

<div class="ghost-stage" data-ghost id={id} style={`--gs:${size}px`}>
  <div class="orbit orbit-1"><span class="spark"></span></div>
  <div class="orbit orbit-2"><span class="spark s2"></span></div>
  <div class="ghost-shadow"></div>

  <div class="ghost-body-wrap">
    <svg class="ghost-svg" viewBox="0 0 240 280" width={size} height={size * 1.16} role="img" aria-label="Cute ghost mascot">
      <defs>
        <linearGradient id={`${id}-skin`} x1="0" y1="0" x2="0.3" y2="1">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="42%" stop-color="#f3eeff"/>
          <stop offset="100%" stop-color="#cdb4fc"/>
        </linearGradient>
        <radialGradient id={`${id}-inner`} cx="50%" cy="34%" r="62%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
          <stop offset="100%" stop-color="#bd93f9" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id={`${id}-cheek`} cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ff8ed0" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="#ff8ed0" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id={`${id}-eye`} cx="50%" cy="38%" r="65%">
          <stop offset="0%" stop-color="#3a3450"/>
          <stop offset="100%" stop-color="#16121f"/>
        </radialGradient>
        <filter id={`${id}-soft`} x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="3"/>
        </filter>
      </defs>

      <!-- back glow layer -->
      <path class="layer-back" d="M44 134 Q44 40 120 40 Q196 40 196 134 L196 214
        Q196 230 182 230 Q170 230 166 218 Q162 230 150 230 Q138 230 134 218
        Q130 230 120 230 Q110 230 106 218 Q102 230 90 230 Q78 230 74 218
        Q70 230 58 230 Q44 230 44 214 Z"
        fill={`url(#${id}-skin)`} filter={`url(#${id}-soft)`} opacity="0.35"
        transform="translate(0 6) scale(1.05)" transform-origin="120 140"/>

      <!-- little arms (behind body) -->
      <g fill={`url(#${id}-skin)`}>
        <ellipse cx="46" cy="158" rx="14" ry="20" transform="rotate(18 46 158)"/>
        <ellipse cx="194" cy="158" rx="14" ry="20" transform="rotate(-18 194 158)"/>
      </g>

      <!-- main body (rounded & chubby with 4 cute waves) -->
      <path class="layer-main" d="M50 138 Q50 48 120 48 Q190 48 190 138 L190 210
        Q190 226 177 226 Q166 226 162 215 Q158 226 147 226 Q136 226 132 215
        Q128 226 120 226 Q112 226 108 215 Q104 226 93 226 Q82 226 78 215
        Q74 226 63 226 Q50 226 50 210 Z"
        fill={`url(#${id}-skin)`}/>
      <path d="M50 138 Q50 48 120 48 Q190 48 190 138 L190 210
        Q190 226 177 226 Q166 226 162 215 Q158 226 147 226 Q136 226 132 215
        Q128 226 120 226 Q112 226 108 215 Q104 226 93 226 Q82 226 78 215
        Q74 226 63 226 Q50 226 50 210 Z" fill={`url(#${id}-inner)`}/>

      <!-- rosy cheeks -->
      <ellipse cx="82" cy="148" rx="15" ry="9" fill={`url(#${id}-cheek)`}/>
      <ellipse cx="158" cy="148" rx="15" ry="9" fill={`url(#${id}-cheek)`}/>

      <!-- big sparkly eyes -->
      <g class="ghost-eyes" transform-origin="120 120">
        <g class="eye">
          <ellipse cx="94" cy="120" rx="15" ry="20" fill={`url(#${id}-eye)`}/>
          <circle class="pupil" cx="99" cy="113" r="5.5" fill="#fff"/>
          <circle class="pupil" cx="89" cy="126" r="2.6" fill="#fff" opacity="0.85"/>
        </g>
        <g class="eye">
          <ellipse cx="146" cy="120" rx="15" ry="20" fill={`url(#${id}-eye)`}/>
          <circle class="pupil" cx="151" cy="113" r="5.5" fill="#fff"/>
          <circle class="pupil" cx="141" cy="126" r="2.6" fill="#fff" opacity="0.85"/>
        </g>
      </g>

      <!-- tiny happy mouth -->
      <path d="M112 150 Q120 160 128 150 Q120 156 112 150 Z" fill="#16121f"/>
    </svg>
  </div>
</div>

<style>
  .ghost-stage { position: relative; width: var(--gs); height: calc(var(--gs) * 1.4);
    display: grid; place-items: center; }
  .ghost-body-wrap { position: relative; z-index: 2; will-change: transform; }
  .ghost-svg { display: block; filter: drop-shadow(0 30px 45px rgba(20,16,40,.6)); }
  .ghost-eyes { animation: blink 6s infinite; transform-origin: 120px 112px; }

  .ghost-shadow {
    position: absolute; bottom: 6%; left: 50%; transform: translateX(-50%);
    width: 46%; height: 22px; border-radius: 50%;
    background: radial-gradient(ellipse, rgba(189,147,249,.5), transparent 70%);
    filter: blur(8px); z-index: 1; will-change: transform, opacity;
  }

  .orbit { position: absolute; inset: 0; z-index: 0; animation: spinSlow linear infinite; }
  .orbit-1 { animation-duration: 14s; }
  .orbit-2 { animation-duration: 22s; animation-direction: reverse; }
  .spark { position: absolute; top: 12%; left: 50%; width: 8px; height: 8px; border-radius: 50%;
    background: var(--cyan); box-shadow: 0 0 14px 3px rgba(139,233,253,.8); }
  .spark.s2 { top: auto; bottom: 16%; left: 22%; background: var(--pink);
    box-shadow: 0 0 14px 3px rgba(255,121,198,.8); width: 6px; height: 6px; }

  @media (prefers-reduced-motion: reduce){
    .ghost-eyes, .orbit { animation: none; }
  }
</style>
