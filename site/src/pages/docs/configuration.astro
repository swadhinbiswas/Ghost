---
import DocsLayout from '../../layouts/DocsLayout.astro';

const envs = [
  { name: 'NVIDIA_API_KEY', desc: 'Enable the Nvidia NIM provider.' },
  { name: 'GHOST_NVIDIA_NIM_MODELS_URL', desc: 'Override the remote Nvidia NIM model catalog URL (defaults to the GitHub-hosted list).' },
  { name: 'GHOST_OPENCODE_MODELS_URL', desc: 'Override the OpenCode Zen models endpoint.' },
  { name: 'GHOST_DISABLE_PROVIDER_AUTO_UPDATE', desc: 'Disable the automatic background model refresh on startup.' },
  { name: 'GHOST_DISABLE_DEFAULT_PROVIDERS', desc: 'Skip all built-in providers (bring-your-own only).' },
  { name: 'GHOST_GLOBAL_CONFIG', desc: 'Override the global config directory.' },
  { name: 'XDG_CONFIG_HOME', desc: 'Standard config location used to resolve ghost.json.' },
];

const exampleConfig = `{
  "options": {
    "debug": false
  },
  "providers": {
    "nvidia-nim": {
      "api_key": "$NVIDIA_API_KEY"
    }
  }
}`;
---

<DocsLayout title="Configuration" description="Config files and environment variables.">
  <p>
    Ghost reads JSON configuration from standard locations and merges it with sensible defaults.
    Most users never need to touch a config file — but everything is tweakable.
  </p>

  <h2>Config file location</h2>
  <p>Ghost looks for <code>ghost.json</code> in your config directory, typically:</p>
  <pre class="block"><code>$XDG_CONFIG_HOME/ghost/ghost.json
# or, if XDG_CONFIG_HOME is unset:
~/.config/ghost/ghost.json</code></pre>
  <p>Project-local <code>ghost.json</code> or <code>.ghost.json</code> files are also discovered by walking up from your working directory, and take priority over global config.</p>

  <h2>Example config</h2>
  <pre class="block"><code>{exampleConfig}</code></pre>

  <h2>Environment variables</h2>
  <table class="docs-table">
    <thead><tr><th>Variable</th><th>Purpose</th></tr></thead>
    <tbody>
      {envs.map((e) => (
        <tr><td><code>{e.name}</code></td><td>{e.desc}</td></tr>
      ))}
    </tbody>
  </table>

  <div class="callout">
    Any <code>GHOST_*</code> environment variable is temporarily applied to the matching provider
    setting at load time, which is handy for one-off overrides.
  </div>

  <h2>Themes</h2>
  <p>Ghost ships with the Dracula theme. Switch themes interactively:</p>
  <pre class="block"><code>ghost theme</code></pre>
</DocsLayout>
